# Supabase Dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=

# Supabase Dashboard → Project Settings → API → anon public key
# 브라우저에 노출되는 공개 키입니다. service_role 키는 넣지 마세요.
VITE_SUPABASE_ANON_KEY=

# OpenAI / Gemini API 키는 프론트엔드 환경변수에 두지 않습니다.
# 이후 Supabase Edge Function 또는 별도 서버에서만 사용합니다.
