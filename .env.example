# Web (Vite). These are public. Do not put the service role key here.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Scripts and local tooling. The browser does not read these.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Edge Function only: local | openai | gemini
# Copy this file's AI values into supabase/functions/.env for `supabase functions serve`.
# That file is gitignored. Never commit a real key.
AI_PROVIDER=local
AI_CONFIDENCE_THRESHOLD=0.8
OPENAI_API_KEY=
GEMINI_API_KEY=
